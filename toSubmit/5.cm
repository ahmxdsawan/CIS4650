/* This program tests 3 various semantic errors: */
/* Type mismatch in operand, Function call parameter number mismatch, Function call type mismatch */

void foo(void) {
    return;
}

int foo1(bool z) {
    return 1;
}

void main(void) {
    int x;
    int y;

    x = x * 2 + 1;
    y = x + foo(); /* Type mismatch in operand */

    foo(x); /* Function call parameter number mismatch */

    foo1(x); /* Function call type mismatch */
}