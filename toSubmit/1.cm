/* This program tests variable assignments and arithmetic, as well as functions */
/* It takes two input integers, and outputs those integers added, subtracted, multiplied, and divided */

int add (int x, int y) {
  return x + y;
}

int subtract(int x, int y) {
  return x - y;
}

int multiply(int x, int y) {
  return x * y;
}

int divide(int x, int y) {
  return x / y;
}

void main(void) {
  int a;
  int b;

  a = input();
  b = input();

  output(add(a, b));
  output(subtract(a, b));
  output(multiply(a, b));
  output(divide(a, b));

}
