/* A program to compute the factorial value of an input */

void foo(int x) {
  return x;
}

void main(void) {
  int x; int fac;
  int y[2]; int x;

  z = x;

  x = y[foo(x)];

  x = foo(x);

  x = 3 + foo(x)/5;

  if (foo(x)) {
    fac = fac * x;
    x = x - 1;
  } 

  while (foo(x)) {
    fac = fac * x;
    x = x - 1;
  } 

  output(foo(x));
  output(x, foo(x));
}
