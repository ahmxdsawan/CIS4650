/* This program tests while loops, conditional statements, and global variables */
/* It takes the size N as input, and then loops to print each number N times */

int N;

void printNumber(int num, int count) {
    int j;
    j = 0;

    while (j < count) {
        output(num);
        j = j + 1;
    }
}

void main(void) {
    int i;
    i = 1;
    
    N = input();
    
    while (i <= N) {
        printNumber(i, i);
        i = i + 1;
    }
}
