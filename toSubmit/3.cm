/* This program tests recursive function calling, loops, arithmetic, and if/else */
/* The program takes a positive integer as input and outputs the fibonacci sequence up to that number */

int fib(int n) {
    int result;
    int a;
    int b;

    result = 0;

    if (n <= 1) {
        result = n;
    } else {
        a = fib(n - 1);
        b = fib(n - 2);
        result = a + b;
    }
    return result;
}

void main(void) {
    int n;
    int i;
    int fibValue;

    n = input();
    i = 0;

    while (i < n) {
        fibValue = fib(i);
        output(fibValue);
        i = i + 1;
    }

}